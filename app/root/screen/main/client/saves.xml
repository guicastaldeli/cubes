<?xml version="1.0" encoding="UTF_8"?>
<saves>
    <label 
        id="saves_title"
        x="5%" y="2%"
        color="1,1,1,1"
        scale="0.8"
    >
        SAVES
    </label>

    <!-- Create New Save -->
    <div
        id="create_save_container"
        x="5%" y="8%"
        width="90%" height="10%"
        background="0.2,0.4,0.8,0.9" 
        hoverable="true" 
        hoverBackground="0.3,0.5,0.9,0.9" 
        hoverScale="1.02"
        action="create_save"
    >
        <label
            id="create_save_label"
            x="0%" y="0%"
            color="1,1,1,1" 
            scale="0.5"
        >
            + CREATE NEW SAVE
        </label>
    </div>

    <!-- Save Name Input -->
    <div
        id="save_name_container"
        x="5%" y="5%" 
        width="90%" height="90%" 
        background="0.6,0.4,0.3,1" 
        visible="false"
    >
        <!-- Save Name -->
        <label
            id="save_name_label" 
            x="5%" y="43%"
            color="1,1,1,1" 
            scale="0.6"
        >
            Save Name:
        </label>
        <input
            id="save_name_input" 
            x="20%" y="40%" 
            width="60%" height="10%" 
            background="0.8,0.8,0.8,0.9" 
            color="0,0,0,1" 
            scale="1.0"
        />

        <!-- Actions -->
            <!-- Cancel -->
            <div 
                id="save_name_cancel" 
                x="65%" y="78%" 
                width="10%" height="10%" 
                background="0.6,0.2,0.2,0.9" 
                hoverable="true" 
                hoverBackground="0.8,0.3,0.3,0.9"
                action="cancel_save"
            >
                <label 
                    x="0%" y="0%" 
                    color="1,1,1,1" 
                    scale="0.4"
                >
                    Cancel
                </label>
            </div>

            <!-- Confirm -->
            <div
                id="save_name_confirm" 
                x="78%" y="78%" 
                width="10%" height="10%" 
                background="0.2,0.6,0.2,0.9" 
                hoverable="true" 
                hoverBackground="0.3,0.8,0.3,0.9"
                action="confirm_save"
            >
                <label 
                    x="0%" y="0%" 
                    color="1,1,1,1" 
                    scale="0.4"
                >
                    Confirm
                </label>
            </div>
    </div>

    <!-- Saves List -->
    <div
        id="saves_list"
        x="5%" y="22%" 
        width="90%" height="70%" 
        background="0.05,0.05,0.05,0.5"
        overflow="scroll"
    >
        {#if Saves.GetAllSaves().Count > 0}
            {#foreach Saves.GetAllSaves() as save}
                <div
                    id="save_entry_{save.SaveId}"
                    x="0%" y="{index * 12}%"
                    width="100%" height="10%" 
                    background="0.1,0.1,0.15,0.9" 
                    hoverable="true" 
                    hoverBackground="0.15,0.15,0.25,0.9"
                    margin="2px"
                >
                    <!-- Save Content -->
                        <!-- Save Name -->
                        <label
                            id="save_name_{save.SaveId}"
                            x="5%" y="0%"
                            color="1,1,1,1"
                            scale="0.5"
                        >
                            {save.SaveId}
                        </label>

                        <!-- Last Played -->
                        <label
                            id="save_last_played_{save.LastPlayed}"
                            x="5%" y="0%"
                            color="1,1,1,1"
                            scale="0.5"
                        >
                            Last Played {save.LastPlayed}
                        </label>

                        <!-- Play Time -->
                        <label
                            id="save_play_time_{save.SaveId}"
                            x="5%" y="0%"
                            color="1,1,1,1"
                            scale="0.5"
                        >
                            Play time: {save.PlayTime}
                        </label>

                    <!-- Actions -->
                        <!-- Load -->
                        <div 
                            id="load_{save.SaveId}" 
                            x="55%" y="0%" 
                            width="15%" height="100%" 
                            background="0.2,0.5,0.2,0.9" 
                            hoverable="true" 
                            hoverBackground="0.3,0.7,0.3,0.9"
                            action="load_save:{save.SaveId}"
                        >
                            <label 
                                x="0%" y="0%" 
                                color="1,1,1,1" 
                                scale="0.35"
                            >
                                Load
                            </label>
                        </div>

                        <!-- Delete -->
                        <div 
                            id="delete_{save.SaveId}" 
                            x="72%" y="0%" 
                            width="15%" height="100%" 
                            background="0.5,0.2,0.2,0.9" 
                            hoverable="true" 
                            hoverBackground="0.7,0.3,0.3,0.9"
                            action="delete_save:{save.SaveId}"
                        >
                            <label 
                                x="0%" y="0%" 
                                color="1,1,1,1" 
                                scale="0.35"
                            >
                                Delete
                            </label>
                        </div>
                </div>
            {#endfor}
        {#else}
            <label 
                id="no_saves_label" 
                x="0%" y="0%"  
                color="0.5,0.5,0.5,1" 
                scale="0.4"
            >
                No saves found. Create a new save!
            </label>
        {#endif}
    </div>
</saves>