<?xml version="1.0" encoding="UTF-8"?>
<saves>
    <label 
        id="saves-title"
        x="5%" y="2%"
        color="1,1,1,1"
        scale="0.8"
    >
        SAVES
    </label>

    <!-- Create New Save -->
    <div
        id="create-save-container"
        x="5%" y="8%"
        width="90%" height="10%"
        background="0.2,0.4,0.8,0.9" 
        hoverable="true" 
        hoverBackground="0.3,0.5,0.9,0.9" 
        hoverScale="1.02"
        action="create-save"
    >
        <label
            id="create-save-label"
            x="0%" y="0%"
            color="1,1,1,1" 
            scale="0.5"
        >
            + CREATE NEW SAVE
        </label>
    </div>

    <!-- Save Name Input -->
    <div
        id="save-name-container"
        x="5%" y="15%" 
        width="90%" height="6%" 
        background="0.1,0.1,0.1,0.9" 
        visible="false"
    >
        <div 
            id="save-name-cancel" 
            x="89%" y="0%" 
            width="10%" height="100%" 
            background="0.6,0.2,0.2,0.9" 
            hoverable="true" 
            hoverBackground="0.8,0.3,0.3,0.9"
            action="cancel-save"
        >
            <label 
                x="0%" y="0%" 
                color="1,1,1,1" 
                scale="0.4"
            >
                Cancel
            </label>
        </div>

        <label
            id="save-name-label" 
            x="2%" y="0%"
            color="1,1,1,1" 
            scale="0.4"
        >
            Save Name:
        </label>
        <input
            id="save-name-input" 
            x="15%" y="0%" 
            width="60%" height="100%" 
            background="0.2,0.2,0.2,0.9" 
            color="1,1,1,1" 
            scale="0.4"
        />

        <div
            id="save-name-confirm" 
            x="78%" y="0%" 
            width="10%" height="100%" 
            background="0.2,0.6,0.2,0.9" 
            hoverable="true" 
            hoverBackground="0.3,0.8,0.3,0.9"
            action="confirm-save"
        >
            <label 
                x="0%" y="0%" 
                color="1,1,1,1" 
                scale="0.4"
            >
                Confirm
            </label>
        </div>
    </div>
</saves>